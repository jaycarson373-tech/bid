{
  "name": "hood-options",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/*.test.mjs",
    "test:solana": "cd programs/hood-options && CARGO_BUILD_JOBS=1 cargo test",
    "build:solana": "cd programs/hood-options && CARGO_BUILD_JOBS=1 anchor build --no-idl",
    "test:vercel": "npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern contracts/lib --ignore-pattern contracts/out --ignore-pattern contracts/cache --ignore-pattern programs/hood-options/target",
    "env:check": "node --env-file-if-exists=.env.production.local scripts/env-check-solana.mjs",
    "setup:production": "npm run env:check && npm run lint && npm test && npm run build && npm run test:solana && npm run build:solana",
    "verify:production": "node --env-file-if-exists=.env.production.local scripts/verify-hood-options.mjs",
    "start:keeper": "node services/options-keeper.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@solana/kit": "^8.2.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.19.0",
    "@solana/react": "^8.2.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.42.0",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "2.56.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "ws": "8.21.0"
  },
  "type": "module"
}
