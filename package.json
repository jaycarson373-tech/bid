{
  "name": "bid-stock-markets",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:sites && node --test tests/*.test.mjs",
    "test:contracts": "forge test --root contracts",
    "test:vercel": "npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern contracts/lib --ignore-pattern contracts/out --ignore-pattern contracts/cache",
    "env:check": "node --env-file-if-exists=.env.production.local scripts/env-check.mjs",
    "costs:production": "node --env-file-if-exists=.env.production.local scripts/production-costs.mjs",
    "deploy:beta": "node --env-file-if-exists=.env.production.local scripts/deploy-beta.mjs",
    "verify:beta": "node --env-file-if-exists=.env.production.local scripts/verify-beta.mjs",
    "recover:beta:check": "node --env-file-if-exists=.env.production.local scripts/recover-beta-liquidity.mjs",
    "recover:beta": "node --env-file-if-exists=.env.production.local scripts/recover-beta-liquidity.mjs --execute",
    "rewards:build": "node scripts/build-rewards-epoch.mjs",
    "setup:production": "npm run env:check && npm run lint && npm run test:contracts && npm run test:vercel",
    "verify:production": "node --env-file-if-exists=.env.production.local scripts/verify-production.mjs",
    "start:keeper": "node services/keeper.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "2.56.1"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "ws": "8.21.0"
  },
  "type": "module"
}
