# Start in simulation mode. Set false only after a successful dry run.
DRY_RUN=true
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Public addresses. Use a creator wallet dedicated to BID.
BID_TOKEN_MINT=
CREATOR_PUBLIC_KEY=
LIQUIDITY_TREASURY=
HOLDER_REWARDS_TREASURY=

# Add this value directly as a protected Railway variable. Never commit it or
# paste it into chat. It is required only when DRY_RUN=false.
CREATOR_SECRET_KEY_B64=

# Supabase Postgres session-pooler or direct connection string.
DATABASE_URL=

LIQUIDITY_BPS=5000
HOLDER_REWARDS_BPS=5000
MIN_CLAIM_LAMPORTS=100000
PRIORITY_FEE_MICROLAMPORTS=1000
