NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Launch display state: prelaunch hides unsourced market telemetry, demo shows labeled sample data, live requires real data sources.
NEXT_PUBLIC_LAUNCH_STATE=prelaunch

# Optional public token contract/mint address. Leave empty until the CA is final.
NEXT_PUBLIC_BID_CONTRACT_ADDRESS=

# Optional public Supabase read API for BID Markets.
# These are safe for the browser only if Row Level Security allows public reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Robinhood Chain + Pons v2 public configuration.
NEXT_PUBLIC_PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
NEXT_PUBLIC_BID_COLLATERAL_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Populate these from `contracts/script/DeployBidMarkets.s.sol` after deployment.
NEXT_PUBLIC_BID_MARKET_FACTORY=
NEXT_PUBLIC_BID_MARKET_MIA_TPA=
NEXT_PUBLIC_BID_MARKET_CITY_FIELD=
NEXT_PUBLIC_BID_MARKET_AUSTIN=
