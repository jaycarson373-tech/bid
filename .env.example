NEXT_PUBLIC_LAUNCH_STATE=prelaunch
NEXT_PUBLIC_BID_NETWORK=mainnet
NEXT_PUBLIC_BID_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_PONS_URL=https://docs.ponsfamily.com/
NEXT_PUBLIC_BID_COLLATERAL_SYMBOL=USDG
NEXT_PUBLIC_CREATOR_TAX_BPS=250
NEXT_PUBLIC_PONS_VERIFIED=false
NEXT_PUBLIC_PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
NEXT_PUBLIC_BID_CONTRACT_ADDRESS=
NEXT_PUBLIC_BID_COLLATERAL_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NEXT_PUBLIC_BID_MARKET_FACTORY=
NEXT_PUBLIC_BID_FLYWHEEL_TREASURY=
NEXT_PUBLIC_BID_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_BID_REWARDS_VAULT=
NEXT_PUBLIC_BID_LIQUIDITY_VAULT=
NEXT_PUBLIC_BID_PROTOCOL_TREASURY=
NEXT_PUBLIC_BID_CREATOR_REWARDS_VAULT=
