# Server/keeper defaults. Execution remains off until production verification passes.
BID_EXPECTED_CHAIN_ID=4663
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
KEEPER_EXECUTION_ENABLED=false
LP_DEPLOYMENT_ENABLED=false
# 100 USDG per eligible market (USDG has 6 decimals).
LP_MIN_DEPLOY_AMOUNT=1000000
LP_TARGET_DEPTH=100000000
PONS_HOOK_SWEEP_ENABLED=false
KEEPER_POLL_INTERVAL_MS=15000
KEEPER_MAX_ORDER_SCAN=500
