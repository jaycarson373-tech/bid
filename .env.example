NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Launch display state: prelaunch hides unsourced market telemetry, demo shows labeled sample data, live requires real data sources.
NEXT_PUBLIC_LAUNCH_STATE=prelaunch

# Optional public token contract/mint address. Leave empty until the CA is final.
NEXT_PUBLIC_BID_CONTRACT_ADDRESS=

# Optional public Supabase read API for BID Markets.
# These are safe for the browser only if Row Level Security allows public reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
